# MongoDB connection string. If it contains <db_password>, set DB_PASSWORD below.
DATABASE=mongodb+srv://<db_user>:<db_password>@<cluster>/<database>
DB_PASSWORD=replace-with-your-database-password

# Use a long, random secret. JWT_EXPIRES_IN accepts jsonwebtoken duration strings (for example: 90d).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=90d
# Cookie lifetime in days.
JWT_COOKIE_EXPIRES_IN=90

NODE_ENV=development
PORT=3000

# Comma-separated exact frontend origins. Set the deployed web app origin here.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_APP_URL=http://localhost:5173
# Use "none" only for cross-site cookie auth (requires HTTPS); bearer tokens work without cookies.
COOKIE_SAME_SITE=lax
CURRENCY=INR
SHIPPING_FEE=0
TAX_RATE=0

# Optional Razorpay test-mode credentials. Do not put live keys in this file or frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional first-admin bootstrap. Set these only when running npm run seed:admin.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Optional: needed only for forgot-password emails.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
