# MongoDB connection string. If it contains <db_password>, set DB_PASSWORD below.
DATABASE=mongodb+srv://<db_user>:<db_password>@<cluster>/<database>
DB_PASSWORD=replace-with-your-database-password

# Use a long, random secret. JWT_EXPIRES_IN accepts jsonwebtoken duration strings (for example: 90d).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=90d
# Cookie lifetime in days.
JWT_COOKIE_EXPIRES_IN=90

NODE_ENV=development
PORT=3000

# Optional: needed only for forgot-password emails.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
